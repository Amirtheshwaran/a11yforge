{
  "name": "@a11yforge/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm build",
    "test": "node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "scan": "node dist/cli.js",
    "scan:fixture": "node dist/scan-fixture.js",
    "scenario:fixture": "node dist/scenario-fixture.js",
    "diagnose:fixture": "node dist/diagnose-fixture.js"
  },
  "dependencies": {
    "@a11yforge/meta": "workspace:*",
    "@a11yforge/shared": "workspace:*",
    "axe-core": "^4.10.3",
    "playwright": "^1.57.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
