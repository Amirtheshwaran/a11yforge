# A11yForge environment template (placeholders only — never real secrets).
# Copy to `.env` (git-ignored) and fill in values locally.

# Meta Model API key for live autonomous runs (server-side only — never
# committed, never sent to the browser). Unset = recorded demo mode only.
MODEL_API_KEY=

# Override the Meta model (default: muse-spark-1.3-contributor).
A11YFORGE_META_MODEL=muse-spark-1.3-contributor

# Maximum Meta model calls per diagnose run (default: 1; diagnose:fixture
# never exceeds one call regardless of this setting's headroom).
A11YFORGE_MAX_MODEL_CALLS_PER_RUN=1

# API listen address (production/container).
PORT=3001
HOST=127.0.0.1

# Public API base the browser calls. This is read at web build time, so set
# it before `pnpm build` when the API will not be on localhost:3001.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Writable runtime root for live-run artifacts and repair workspaces
# (production). Defaults to the working tree for local development.
A11YFORGE_DATA_DIR=

# Live-run artifact directory override (rarely needed; derived from the
# data dir when unset). Live runs never write into demo/accepted-run.
A11YFORGE_RUNS_DIR=

# API CORS origin (default: *). The API serves only run artifacts and never
# accepts secrets from browsers, so the permissive default is safe.
A11YFORGE_CORS_ORIGIN=*

# Release label reported by GET /health (default: 0.7.0).
A11YFORGE_VERSION=

# Allow the universal explorer to test loopback/private targets such as
# http://localhost:3000 (local development only). Default is public
# addresses only. Never enable on an untrusted public deployment.
A11YFORGE_ALLOW_PRIVATE_TARGETS=
